# Public browser configuration only. Never place a service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Explicitly true to use isolated, labelled in-memory preview even with credentials.
VITE_PREVIEW_MODE=false

# Netlify: set the real value in the Netlify dashboard, available to Functions.
# Never prefix a server secret with VITE_ and never commit an actual .env file.
UNIPLAST_SETUP_KEY=
# Optional canonical HTTPS URL for a custom domain. The Netlify URL is automatic.
UNIPLAST_SITE_URL=
# Set AWS_LAMBDA_JS_RUNTIME=nodejs24.x in the Netlify dashboard, then redeploy.
