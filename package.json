{
  "name": "uniplast-store",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native --host 127.0.0.1",
    "build": "node scripts/prepare-server.cjs && tsc -b && vite build --configLoader native && vite build --configLoader native --mode web --outDir out",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "test:database": "node --test --experimental-strip-types supabase/tests/*.test.ts",
    "check": "tsc -b",
    "format": "prettier --write src tests supabase/tests vite.config.mjs",
    "build:web": "node scripts/prepare-server.cjs && tsc -b && vite build --configLoader native --mode web --outDir out",
    "test:local": "node scripts/prepare-server.cjs && node --test server/tests/*.test.cjs",
    "build:netlify": "node scripts/prepare-server.cjs && tsc -b && vite build --configLoader native --mode netlify --outDir dist-netlify",
    "test:netlify": "node scripts/prepare-server.cjs && node --test server/tests/netlify.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.7",
    "@supabase/supabase-js": "^2.57.0",
    "@zxing/browser": "^0.1.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "3.6.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
